# ---- OpenAI (required for chat, voice and calls) ----
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=ash
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=ash

# ---- Use YOUR OWN AI API instead of OpenAI for the chat (optional) ----
# Must be OpenAI-compatible: POST {AI_BASE_URL}/chat/completions with tools + stream.
# AI_BASE_URL=https://your-api.example.com/v1
# AI_API_KEY=...
# AI_CHAT_MODEL=your-model

# ---- Use YOUR OWN PRODUCT API instead of the local catalog (optional) ----
# GET returns a JSON array of products (format in README).
# CATALOG_API_URL=https://your-api.example.com/products
# CATALOG_API_KEY=...

# ---- Admin dashboard (/admin) ----
# If empty, a password is generated once and saved in data/admin-password.txt
ADMIN_PASSWORD=

# ---- Card payments with Stripe (optional) ----
# Without it, customers can still order with "Pay later".
STRIPE_SECRET_KEY=

# ---- Live phone calls (Twilio, optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1...
# Public https address of this server (your domain, or a tunnel)
PUBLIC_URL=

PORT=3000

# ---- FARQ knowledge API (optional) ----
# OpenAI stays the brain; this API is asked for FARQ facts (POST {URL}/v1/chat).
KNOWLEDGE_API_URL=
KNOWLEDGE_API_KEY=
KNOWLEDGE_TIMEOUT_MS=20000
KNOWLEDGE_ONLY=false            # true = chat answers ONLY from the knowledge API (+ product catalog)
BRAND_NAME=                     # e.g. Lonely Ghost
STORE_CURRENCY=USD              # currency to request from a Shopify catalog
# Shopify store example: CATALOG_API_URL=https://yourstore.com/products.json

# ---- Static front-end on another domain (e.g. GitHub Pages) ----
# Comma-separated origins allowed to call this server's /api, e.g. https://is-studio-hub.github.io
ALLOWED_ORIGINS=

# ---- Persistent storage (hosting, e.g. Railway volume mounted at /data) ----
# Leave empty locally (uses ./data and ./public/uploads).
DATA_DIR=
UPLOAD_DIR=
